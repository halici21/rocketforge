import QtQuick
import RocketForge 1.0
import "../../ui/data" as Data
import "../../ui/engine/model"

QtObject {
    property var nav: Data.Navigation
    property var thermo: Thermochemistry
    property var perf: RocketPerformance
    property var fluid: FluidProperties
    property var line: Line
    property var oblique: ObliqueShock
    property var study: TradeStudy
    property var em: EngineModel

    // Selects a component worth showing in a topology screenshot, by type
    // rather than by id -- ids are generated by addNode() at load time.
    function selectRepresentativeNode() {
        for (var i = 0; i < EngineModel.nodes.count; ++i) {
            var n = EngineModel.nodes.get(i)
            // The role is `nodeId`, not `id` -- see EngineModel.addNode.
            if (n.type === "chamber" || n.type === "nozzle") {
                EngineModel.selectNode(n.nodeId, false)
                return n.name
            }
        }
        if (EngineModel.nodes.count > 0) {
            EngineModel.selectNode(EngineModel.nodes.get(0).nodeId, false)
            return EngineModel.nodes.get(0).name
        }
        return ""
    }
}
