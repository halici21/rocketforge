.venv-fluids-spike/
__pycache__/
*.pyc
*.qmlc
*.jsc
.qmlls.ini
.pytest_cache/

# Packaging output. The build is reproducible from build_exe.bat, so the
# 150 MB of Qt runtime it produces does not belong in the source tree.
build/
dist/
*.ico

# Generated smoke-test / acceptance screenshots and packaged self-test
# output. Reproducible from the scripts that made them, not source.
# `/acceptance/` is anchored to the repository root: an unanchored pattern
# also matched tests/acceptance/, and the freeze-manifest tests were never
# committed or run in CI because of it.
packaged_out/
packaged_selftest*/
/acceptance/
shell_smoke/
perf_smoke/
study_smoke/
ui_smoke/
line_smoke/
fluid_smoke/
coupling_smoke/

# Scratch produced while investigating: a run log, and the pre-edit copies a
# refactor leaves behind. Both are reproducible and neither is source.
*.log
*.bak

# OS / editor junk - never project-relevant, easy to drop in by accident.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
